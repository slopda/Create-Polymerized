+    private InteractionResult openVanillaMenu(Level level, BlockPos pos, Player player) {
+        if (level.isClientSide()) {
+            return InteractionResult.SUCCESS;
+        }
+        if (!(player instanceof ServerPlayer serverPlayer) || serverPlayer.isSpectator()
+            || !serverPlayer.mayInteract(serverPlayer.level(), pos)) {
+            return InteractionResult.SUCCESS;
+        }
+
+        withBlockEntityDo(level, pos, toolbox ->
+            com.zurrtum.create.infrastructure.polymer.gui.PolymerToolboxGui.open(serverPlayer, toolbox));
