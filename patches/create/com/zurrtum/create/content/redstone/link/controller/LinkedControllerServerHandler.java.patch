+    /** Toggles a controller button for vanilla clients that cannot send Create keybind packets. */
+    public static boolean togglePersistentButton(
+        LevelAccessor world,
+        BlockPos pos,
+        UUID playerId,
+        int button,
+        Couple<Frequency> frequency
+    ) {
+        Map<UUID, Map<Integer, Couple<Frequency>>> byPlayer = persistentInputs.get(world);
+        Map<Integer, Couple<Frequency>> active = byPlayer.computeIfAbsent(playerId, $ -> new HashMap<>());
+        Couple<Frequency> existing = active.remove(button);
+        if (existing != null) {
+            if (!active.containsValue(existing)) {
+                receivePressed(world, pos, playerId, List.of(existing), false);
+            }
+            if (active.isEmpty()) {
+                byPlayer.remove(playerId);
+            }
+            return false;
+        }
+
+        boolean alreadyActive = active.containsValue(frequency);
+        active.put(button, frequency);
+        if (!alreadyActive) {
+            receivePressed(world, pos, playerId, List.of(frequency), true);
+        }
+        return true;
+    }
+
+    public static void releasePersistentInputs(LevelAccessor world, BlockPos pos, UUID playerId) {
+        Map<Integer, Couple<Frequency>> active = persistentInputs.get(world).remove(playerId);
+        if (active != null && !active.isEmpty()) {
+            receivePressed(world, pos, playerId, new ArrayList<>(new HashSet<>(active.values())), false);
+        }
+    }
+
+    private static void refreshPersistentInputs(LevelAccessor world) {
+        Map<UUID, Map<Integer, Couple<Frequency>>> byPlayer = persistentInputs.get(world);
+        for (Iterator<Map.Entry<UUID, Map<Integer, Couple<Frequency>>>> iterator = byPlayer.entrySet().iterator(); iterator.hasNext(); ) {
+            Map.Entry<UUID, Map<Integer, Couple<Frequency>>> entry = iterator.next();
+            if (entry.getValue().isEmpty()) {
+                iterator.remove();
+                continue;
+            }
+
+            if (!(world.getPlayerByUUID(entry.getKey()) instanceof ServerPlayer player)) {
+                receivePressed(
+                    world,
+                    BlockPos.ZERO,
+                    entry.getKey(),
+                    new ArrayList<>(new HashSet<>(entry.getValue().values())),
+                    false
+                );
+                iterator.remove();
+                continue;
+            }
+            receivePressed(
+                world,
+                player.blockPosition(),
+                entry.getKey(),
+                new ArrayList<>(new HashSet<>(entry.getValue().values())),
+                true
+            );
         }
